# Copy to server/.env and adjust for your local Postgres.
DATABASE_URL=postgres://postgres@localhost:5432/library_system
PORT=4000

# Signs session cookies. Required in production — the server refuses to start
# without it, because a predictable key lets anyone mint an Admin session.
# Left unset in development a random key is generated per process, so sessions
# simply end when the server restarts.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Comma-separated browser origins allowed to send authenticated requests.
# Defaults to the Vite dev server; only needed when the client is served from
# a different origin than the API.
# CORS_ORIGIN=http://localhost:5173
