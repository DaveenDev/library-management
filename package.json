{
  "name": "lumen-library-system",
  "private": true,
  "version": "1.0.0",
  "description": "Lumen Library System — full-stack port (React + Express + Postgres)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:push": "npm run db:push --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "setup": "npm run db:push && npm run db:seed",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
