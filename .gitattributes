# Normalise line endings so Windows, macOS and Linux contributors don't
# produce whole-file diffs just by saving. Text files are stored with LF in
# the repository and checked out with the platform's native endings.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
